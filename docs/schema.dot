    fact_goods_receipt_line [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#7A4B63"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>fact_goods_receipt_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="gr_line_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10"><B>gr_line_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#C9A227"><B>PK</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="goods_receipt_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">goods_receipt_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="po_line_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">po_line_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="item_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">item_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="store_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">store_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">date_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_received" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">quantity_received</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="amount" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">decimal</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR></TABLE>>];
