ZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">total_amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">decimal</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR></TABLE>>];
