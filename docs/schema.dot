digraph schema {
  graph [rankdir=LR, splines=spline, newrank=true, compound=true,
         nodesep=0.40, ranksep=3.2, bgcolor="#F4F4F7", fontname="Helvetica",
         pad=0.5, concentrate=false,
         label=<<FONT POINT-SIZE="26"><B>Retail &amp; Logistics Intelligence — Galaxy Schema</B></FONT><BR/>
                <FONT POINT-SIZE="14" COLOR="#5A5A6E">One fact table per business process, sharing conformed dimensions.<BR ALIGN="CENTER"/>Stock is derived from movements, never stored. Sales are stored once, at receipt grain.</FONT><BR/> >,
         labelloc=t, fontsize=14];
  node [shape=plaintext, fontname="Helvetica"];
  edge [color="#A8AEC2", arrowsize=0.6, penwidth=0.9];

  subgraph cluster_sell {
    label=<<FONT POINT-SIZE="15" COLOR="#2E7D6F"><B>SELLING</B></FONT>>;
    labeljust=l; style="rounded,filled"; fillcolor="#FFFFFF";
    color="#2E7D6F"; penwidth=1.4; margin=16;
    fact_receipt [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2E7D6F"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>fact_receipt</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="receipt_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10"><B>receipt_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#C9A227"><B>PK</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="receipt_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">receipt_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">varchar</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="store_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">store_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">date_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="receipt_datetime" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">receipt_datetime</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">datetime</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="staff_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">staff_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">total_amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">decimal</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="total_items" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">total_items</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR></TABLE>>];
    fact_receipt_line [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#2E7D6F"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>fact_receipt_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="receipt_line_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10"><B>receipt_line_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#C9A227"><B>PK</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="receipt_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">receipt_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="item_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">item_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="store_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">store_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">date_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">quantity</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="amount" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">decimal</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR></TABLE>>];
  }
  subgraph cluster_order {
    label=<<FONT POINT-SIZE="15" COLOR="#8A6A3D"><B>ORDERING  (no stock effect)</B></FONT>>;
    labeljust=l; style="rounded,filled"; fillcolor="#FFFFFF";
    color="#8A6A3D"; penwidth=1.4; margin=16;
    fact_purchase_order [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#8A6A3D"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>fact_purchase_order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_order_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10"><B>purchase_order_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#C9A227"><B>PK</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="po_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">po_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">varchar</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="vendor_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">vendor_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="store_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">store_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_staff_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">buyer_staff_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">order_date</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">date</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="date_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">date_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">total_amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">decimal</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR></TABLE>>];
    fact_purchase_order_line [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#8A6A3D"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>fact_purchase_order_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="po_line_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10"><B>po_line_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">bigint</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#C9A227"><B>PK</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_order_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">purchase_order_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="item_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">item_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="store_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">store_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">date_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity_ordered" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">quantity_ordered</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="amount" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">decimal</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR></TABLE>>];
  }
  subgraph cluster_recv {
    label=<<FONT POINT-SIZE="15" COLOR="#7A4B63"><B>RECEIVING  (stock moves here)</B></FONT>>;
    labeljust=l; style="rounded,filled"; fillcolor="#FFFFFF";
    color="#7A4B63"; penwidth=1.4; margin=16;
    fact_goods_receipt [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#7A4B63"><FONT COLOR="#FFFFFF" POINT-SIZE="13"><B>fact_goods_receipt</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="goods_receipt_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10"><B>goods_receipt_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#C9A227"><B>PK</B></FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="document_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">document_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">varchar</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_order_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">purchase_order_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="supplier_invoice_number" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">supplier_invoice_number</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">varchar</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"> </TD></TR><TR><TD ALIGN="LEFT" PORT="vendor_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">vendor_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="store_id" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="10">store_id</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="9" COLOR="#7A7A8C">int</FONT></TD><TD ALIGN="RIGHT" BGCOLOR="#FBFBFD"><FONT POINT-SIZE="8"><FONT COLOR="#8FA8C8">FK</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="posting_date" BGCOLOR