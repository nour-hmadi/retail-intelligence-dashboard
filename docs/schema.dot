  subgraph cluster_move {
    label=<<FONT POINT-SIZE="15" COLOR="#4A5A8A"><B>TRANSFERRING</B></FONT>>;
    labeljust=l; style="rounded,filled"; fillcolor="#FFFFFF";
    color="#4A5A8A"; penwidth=1.4; margin=16;
